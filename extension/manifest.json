{
  "manifest_version": 3,
  "name": "Cue for Bingers",
  "short_name": "Cue",
  "version": "1.2.0",
  "description": "Unofficial companion for Bingers: see your status on IMDb and TMDB, catch your next episode, and mark titles watched.",
  "minimum_chrome_version": "116",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Cue for Bingers",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "options_ui": {
    "page": "options/options.html",
    "open_in_tab": true
  },
  "permissions": [
    "storage",
    "identity",
    "contextMenus",
    "scripting",
    "activeTab",
    "declarativeContent"
  ],
  "host_permissions": [
    "https://api.bingers.app/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://www.imdb.com/*",
        "https://m.imdb.com/*",
        "https://www.themoviedb.org/*"
      ],
      "js": [
        "content/content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "optional_host_permissions": [
    "https://*/*",
    "http://*/*"
  ]
}
